# Copy to .env for local development (git-ignored). In production these are
# set directly on Render (see render.yaml) rather than loaded from a file.

# --- Rails ---
# Decrypts config/credentials.yml.enc; required in production. Find the dev
# value in config/master.key (never commit that file).
RAILS_MASTER_KEY=

# --- Database (only needed if not using Render's auto-provided DATABASE_URL) ---
# DATABASE_URL=postgres://user:password@host:5432/roost_assured_production

# --- Stripe (Connect marketplace payments) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Checkr (sitter background checks) ---
CHECKR_API_KEY=
CHECKR_WEBHOOK_KEY=
# The package slug configured in the Checkr dashboard; defaults to "tasker_pro".
CHECKR_PACKAGE=

# --- Resend (transactional email) ---
RESEND_API_KEY=
MAILER_FROM="Roost Assured <noreply@roostassured.com>"

# --- Admin dashboard (HTTP Basic auth, gates /admin) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Misc ---
# Host used to build links in mailer templates and in config.hosts.
APP_HOST=roostassured.com
