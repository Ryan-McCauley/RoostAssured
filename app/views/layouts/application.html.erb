<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Roost Assured – Trusted Backyard Chicken Sitters</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Roost Assured connects backyard chicken owners with trusted local sitters for feeding, egg collection, and coop care while you're away.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Roost Assured">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="robots" content="index, follow">
    <%= csrf_meta_tags %>

    <script>
      (function () {
        try {
          var stored = localStorage.getItem("roost-theme");
          var theme = stored || (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag "application.jsx" %>
  </head>

  <body>
    <div id="root"></div>
  </body>
</html>
