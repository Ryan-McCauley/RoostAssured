<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title><%= yield(:title) if content_for?(:title) %></title>
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <style>
      body, table, td { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
      a { color: #b45309; }
      @media (max-width: 600px) {
        .ra-container { width: 100% !important; }
        .ra-px { padding-left: 20px !important; padding-right: 20px !important; }
      }
    </style>
  </head>

  <body style="margin: 0; padding: 0; background-color: #f6f2e6;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f6f2e6;">
      <tr>
        <td align="center" style="padding: 32px 16px;">
          <table role="presentation" class="ra-container" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 600px; max-width: 100%; background-color: #ffffff; border-radius: 14px; overflow: hidden; border: 1px solid #e7e5e4;">

            <!-- Header -->
            <tr>
              <td class="ra-px" align="center" style="background-color: #241c15; padding: 28px 32px;">
                <img src="<%= "#{root_url.chomp('/')}/icon.png" %>" width="40" height="40" alt="" style="display: block; border-radius: 9px; margin: 0 auto 10px;">
                <span style="font-size: 17px; font-weight: 700; letter-spacing: 0.01em; color: #f6f2e6;">Roost Assured</span>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td class="ra-px" align="center" style="padding: 36px 32px; color: #1c1917; font-size: 15px; line-height: 1.65; text-align: center;">
                <%= yield %>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td class="ra-px" align="center" style="padding: 22px 32px 30px; border-top: 1px solid #e7e5e4;">
                <p style="margin: 0; font-size: 12.5px; line-height: 1.6; color: #78716c;">
                  Roost Assured &middot; Trusted backyard chicken sitting<br>
                  <a href="<%= root_url %>" style="color: #78716c; text-decoration: underline;">roostassured.com</a>
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
