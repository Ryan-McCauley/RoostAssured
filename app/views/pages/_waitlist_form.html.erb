<%= form_with model: waitlist_signup, url: waitlist_signups_path, class: "max-w-md mx-auto" do |f| %>
  <div class="flex flex-col sm:flex-row gap-3 mb-3">
    <%= f.email_field :email, required: true, placeholder: "you@example.com",
          class: "flex-1 rounded-lg border border-stone-300 px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-amber-500" %>
    <%= f.submit "Join the waitlist",
          class: "rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-semibold px-6 py-3 cursor-pointer transition" %>
  </div>

  <div class="flex flex-col sm:flex-row gap-3 text-sm">
    <%= f.text_field :zip_code, placeholder: "ZIP code (optional)",
          class: "flex-1 rounded-lg border border-stone-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-amber-500" %>
    <%= f.select :role,
          options_for_select([["I have chickens", "owner"], ["I'd sit for chickens", "sitter"], ["Both", "both"]], waitlist_signup.role),
          { include_blank: "I am a..." },
          class: "flex-1 rounded-lg border border-stone-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-amber-500" %>
  </div>
<% end %>
